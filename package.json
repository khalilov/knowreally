{
  "name": "knowreally",
  "version": "0.1.0",
  "description": "Verification of declaratively described conditions",
  "keywords": [],
  "license": "ISC",
  "author": "Sergey Khalilov <sergey.khalilov@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "skills"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run build",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "pack:check": "npm pack --dry-run"
  },
  "prepublishOnly": "npm run check",
  "dependencies": {
    "objwalk": "^1.11.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
